<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="24x7 Healthcare"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Top Doctors"
            android:textColor="#F59E0B"
            android:textSize="20sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/family"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_family" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Family Physician"
                    android:textColor="#B45309"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dietician"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_diet" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Dietician"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dentist"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dentist" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Dentist"
                    android:textColor="#C2410C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/surgeon"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_surgeon" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Surgeon"
                    android:textColor="#DC2626"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardio"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cardio" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Cardiologist"
                    android:textColor="#DB2777"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/back"
                android:layout_width="0dp"
                android:layout_height="166dp"
                android:layout_columnWeight="1"
                android:layout_margin="10dp"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/icon_badge_bg">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Back"
                    android:textColor="#4F46E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </GridLayout>

    </LinearLayout>
</ScrollView>
